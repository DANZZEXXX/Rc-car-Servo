/*Robot arm control with Arduino BSCPROJECT */ 
#include <Wire.h> 
#include <Adafruit_PWMServoDriver.h> 

// Setup Pin I2C (SDA otomatis ke A4, SCL otomatis ke A5 di Arduino Uno)
#define SDA_PIN A4
#define SCL_PIN A5

Adafruit_PWMServoDriver BSCPROJECT = Adafruit_PWMServoDriver(); 

#define servo1 0 
#define servo2 1 
#define servo3 2 
#define servo4 3 

void setup() { 
  Serial.begin(9600); 
  Wire.begin(); // Mulai komunikasi I2C di pin A4 (SDA) dan A5 (SCL)
  
  BSCPROJECT.begin(); 
  BSCPROJECT.setPWMFreq(60); 
  
  BSCPROJECT.setPWM(servo1, 0, 330); 
  BSCPROJECT.setPWM(servo2, 0, 150); 
  BSCPROJECT.setPWM(servo3, 0, 300); 
  BSCPROJECT.setPWM(servo4, 0, 410); 
  delay(3000); 
} 

void loop() { 
  for (int S1value = 330; S1value >= 250; S1value--) { 
    BSCPROJECT.setPWM(servo1, 0, S1value); 
    delay(10); 
  } 
  for (int S2value = 150; S2value <= 380; S2value++) { 
    BSCPROJECT.setPWM(servo2, 0, S2value); 
    delay(10); 
  } 
  for (int S3value = 300; S3value <= 380; S3value++) { 
    BSCPROJECT.setPWM(servo3, 0, S3value); 
    delay(10); 
  } 
  for (int S4value = 410; S4value <= 510; S4value++) { 
    BSCPROJECT.setPWM(servo4, 0, S4value); 
    delay(10); 
  } 
  //////////////////////// 
  delay(2000); 
  
  for (int S4value = 510; S4value > 410; S4value--) { 
    BSCPROJECT.setPWM(servo4, 0, S4value); 
    delay(10); 
  } 
  for (int S3value = 380; S3value > 300; S3value--) { 
    BSCPROJECT.setPWM(servo3, 0, S3value); 
    delay(10); 
  } 
  for (int S2value = 380; S2value > 150; S2value--) { 
    BSCPROJECT.setPWM(servo2, 0, S2value); 
    delay(10); 
  } 
  for (int S1value = 250; S1value < 450; S1value++) { 
    BSCPROJECT.setPWM(servo1, 0, S1value); 
    delay(10); 
  } 
  ////////////////////// 
  for (int S2value = 150; S2value <= 380; S2value++) { 
    BSCPROJECT.setPWM(servo2, 0, S2value); 
    delay(10); 
  } 
  for (int S3value = 300; S3value <= 380; S3value++) { 
    BSCPROJECT.setPWM(servo3, 0, S3value); 
    delay(10); 
  } 
  for (int S4value = 410; S4value <= 510; S4value++) { 
    BSCPROJECT.setPWM(servo4, 0, S4value); 
    delay(10); 
  } 
  for (int S4value = 510; S4value > 410; S4value--) { 
    BSCPROJECT.setPWM(servo4, 0, S4value); 
    delay(10); 
  } 
  ///////////////// 
  for (int S3value = 380; S3value > 300; S3value--) { 
    BSCPROJECT.setPWM(servo3, 0, S3value); 
    delay(10); 
  } 
  for (int S2value = 380; S2value > 150; S2value--) { 
    BSCPROJECT.setPWM(servo2, 0, S2value); 
    delay(10); 
  } 
  for (int S1value = 450; S1value > 330; S1value--) { 
    BSCPROJECT.setPWM(servo1, 0, S1value); 
    delay(10); 
  } 
}
